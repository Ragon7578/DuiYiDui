{
  "name": "contract-spirit",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:web": "npm run dev -w @contract-spirit/web",
    "dev:api": "npm run dev -w @contract-spirit/api",
    "stop": "bash scripts/stop.sh",
    "build": "npm run build -w @contract-spirit/api && npm run build -w @contract-spirit/web",
    "seed": "npm run seed -w @contract-spirit/api",
    "lint": "npm run lint -w @contract-spirit/web",
    "test": "npm run test -w @contract-spirit/api && npm run test -w @contract-spirit/web",
    "test:api": "npm run test -w @contract-spirit/api",
    "test:web": "npm run test -w @contract-spirit/web",
    "smoke": "bash scripts/smoke.sh",
    "backup:db": "bash scripts/backup-sqlite.sh"
  }
}
