# 本地 / 公网部署环境变量示例（复制为 .env 后填写）

# —— API ——
PORT=4000
NODE_ENV=production
JWT_SECRET=请换成足够长的随机字符串
APP_URL=https://your-web-domain.example
FRONTEND_ORIGIN=https://your-web-domain.example
# 可选：自定义 SQLite 路径（Docker 默认 /data/contract-spirit.db）
# DB_PATH=./apps/api/data/contract-spirit.db
# OPENAI_API_KEY=
# 反馈运营导出（GET /api/feedback 请求头 X-Feedback-Ops-Key）
# FEEDBACK_OPS_KEY=请换成足够长的随机字符串

# 密码重置：生产默认不在响应中返回 resetUrl（仍写服务端日志）
# 本地开发可设 true；公网 Staging 保持 false，改走 SUPPORT_EMAIL / 意见反馈值班
EXPOSE_RESET_URL=false
# 人工协助重置的对外联系邮箱（写入忘记密码文案）
SUPPORT_EMAIL=ops@your-domain.example
# 值班读取反馈：curl -H "X-Feedback-Admin-Key: $FEEDBACK_ADMIN_KEY" $API/api/feedback
FEEDBACK_ADMIN_KEY=请换成随机密钥

# —— Web（构建时也需要 NEXT_PUBLIC_*）——
NEXT_PUBLIC_API_URL=https://your-api-domain.example
